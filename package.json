{
  "name": "twitch-clip-mate",
  "version": "1.0.0",
  "description": "Twitch Clip Mate - Extract and play Twitch clips with ease.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "postinstall": "echo \"Skipping Playwright browser download. Set CHROMIUM_EXECUTABLE_PATH or run npm run install:playwright if needed.\"",
    "install:playwright": "playwright install --only-shell --no-progress chromium"
  },
  "author": "",
  "license": "GPL-3.0",
  "dependencies": {
    "axios": "^1.18.1",
    "express": "^5.2.1",
    "i18next": "^26.3.2",
    "i18next-fs-backend": "^2.6.6",
    "i18next-http-middleware": "^3.9.7",
    "playwright": "^1.61.1",
    "pug": "^3.0.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
