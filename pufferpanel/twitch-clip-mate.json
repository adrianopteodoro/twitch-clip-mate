{
  "type": "nodejs",
  "display": "Twitch Clip Mate",
  "author": "Streamer.bot",
  "description": "Twitch Clip Mate - Extract and play Twitch clips with ease",
  "documentation": "https://github.com/adrianopteodoro/twitch-clip-player",
  "version": "1.0.0",
  "data": {
    "PORT": {
      "type": "string",
      "value": "3000",
      "display": "Port",
      "desc": "Port for the web interface",
      "required": true,
      "userEdit": false
    }
  },
  "install": [
    {
      "type": "download",
      "files": [
        "https://github.com/adrianopteodoro/twitch-clip-player/archive/refs/heads/main.zip"
      ]
    },
    {
      "type": "command",
      "commands": [
        "unzip -o twitch-clip-mate-main.zip",
        "find . -maxdepth 1 -type d -name 'twitch-clip-*-main' -exec cp -a {}/. . \\;",
        "find . -maxdepth 1 -type d -name 'twitch-clip-*-main' -exec rm -rf {} \\;"
      ]
    },
    {
      "type": "command",
      "commands": [
        "npm install --omit=dev --no-audit --ignore-scripts"
      ]
    }
  ],
  "uninstall": null,
  "run": {
    "command": "npm start",
    "environmentVars": {
      "PORT": "${PORT}"
    },
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "host"
  },
  "supportedEnvironments": [
    {
      "type": "host"
    }
  ],
  "requirements": {
    "os": "linux",
    "arch": "amd64"
  },
  "stats": {
    "type": ""
  },
  "query": {
    "type": ""
  },
  "keepAlive": {
    "frequency": "",
    "command": ""
  },
  "name": "twitch-clip-mate"
}
